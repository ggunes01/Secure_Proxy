# Copy this file to .env locally or export the same variables in your shell.
# Do not commit real tokens, IP addresses, or private keys.

# Shared secret. Use the same value on the AWS server and your local client.
PROXY_AUTH_TOKEN=change-me-to-a-long-random-token

# Server process on the AWS EC2 instance.
SERVER_LISTEN_HOST=0.0.0.0
PROXY_SERVER_PORT=9000
MAX_CONNECTIONS=200
ALLOWED_TARGET_PORTS=80,443
BLOCKED_TARGET_HOSTS=localhost,127.0.0.1,0.0.0.0

# Local client process on your computer.
CLIENT_LISTEN_HOST=127.0.0.1
CLIENT_LISTEN_PORT=8080

# Public DNS name or Elastic IP of the AWS EC2 instance.
# PROXY_SERVER_HOST is the canonical name. AWS_PROXY_HOST/AWS_PUBLIC_IP are also supported.
PROXY_SERVER_HOST=203.0.113.10

# Timeouts.
CONNECT_TIMEOUT_SECONDS=10
IDLE_TIMEOUT_SECONDS=120

# Optional TLS between local client and AWS server.
CLIENT_SERVER_TLS=false
# PROXY_TLS_CERT_PATH=/path/on/aws/server.crt
# PROXY_TLS_KEY_PATH=/path/on/aws/server.key
# PROXY_CA_CERT_PATH=/path/on/local/ca-or-server.crt
